{
  "model": "transfer_model",
  "architecture": "yolov8m",
  "epochs": 30,
  "head_epochs": 3,
  "fine_tune_epochs": 12,
  "final_tune_epochs": 15,
  "batch_size": 16,
  "fine_tune_blocks": 3,
  "final_tune_blocks": 5,
  "dropout": 0.5,
  "learning_rate": 0.00001,
  "classifier_learning_rate": 0.0003,
  "fine_tune_classifier_learning_rate": 0.0001,
  "final_classifier_learning_rate": 0.00005,
  "final_learning_rate": 0.000005,
  "new_blocks_learning_rate": 0.000002,
  "weight_decay": 0.001,
  "label_smoothing": 0.05,
  "checkpoint_monitor": "val_loss",
  "lr_scheduler": {"factor": 0.5, "patience": 2, "min_lr": 0.0000001},
  "early_stopping": {"patience": 6, "min_delta": 0.0005},
  "seed": 42
}
